# ==============================================================================
# codewise — Environment Configuration
# understand the code. master the logic.
# ==============================================================================

# Application Environment ('development' or 'production')
ENV=development

# Optional AI Provider API Keys (Leave blank to use the built-in Local Static Engine)
# No API key is required to use codewise!
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
CODEWISE_AI_KEY=

# Preferred AI Provider when key is configured: 'auto', 'openai', 'gemini'
AI_PROVIDER=auto
AI_MODEL_NAME=gpt-4o-mini

# Backend Host & Port
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Frontend Dev Port
FRONTEND_PORT=5173
