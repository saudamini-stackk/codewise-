# ==============================================================================
# codewise — Environment Configuration
# understand the code. master the logic.
# ==============================================================================

# Application Environment ('development' or 'production')
ENV=development

# Optional AI Provider API Keys (Leave blank to use the built-in Local Static Engine)
# No API key is required to use codewise!
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CODEWISE_AI_KEY=

# Preferred AI Provider when key is configured: 'gemini', 'openai', 'auto'
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-1.5-flash
AI_MODEL_NAME=gemini-1.5-flash

# Backend Host & Port
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Frontend Dev Port
FRONTEND_PORT=5173
